@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap');
:root{font-family:'DM Sans',sans-serif;color:#e8edf7;background:#080d18;font-synthesis:none;text-rendering:optimizeLegibility}*{box-sizing:border-box}body{margin:0;min-width:320px;background:radial-gradient(ellipse at 70% -20%,#172643 0,transparent 42%),#080d18}button{font:inherit;cursor:pointer}.shell{min-height:100vh}.sidebar{width:246px;position:fixed;inset:0 auto 0 0;background:#0b1120;border-right:1px solid #1d2940;padding:25px 15px;display:flex;flex-direction:column;z-index:3}.brand{display:flex;align-items:center;gap:11px;padding:0 8px 27px}.brandicon{height:39px;width:39px;display:grid;place-items:center;border-radius:12px;background:linear-gradient(145deg,#4f8cff,#6c5ce7);color:white;box-shadow:0 8px 25px #375bd344}.brand b{font:800 19px Manrope,sans-serif;letter-spacing:-.6px}.brand b span{color:#7ca6ff}.brand small,.workspace small,.operator small{display:block;font-size:9px;color:#71809a;letter-spacing:1.2px;margin-top:4px}.workspace{display:flex;align-items:center;gap:10px;padding:12px 10px;border:1px solid #243149;background:#111a2c;border-radius:11px;margin-bottom:26px}.workspace>span,.operator>span{display:grid;place-items:center;background:#263d66;color:#a8c6ff;width:32px;height:32px;border-radius:9px;font-size:11px;font-weight:700}.workspace b,.operator b{font-size:11px}.workspace small,.operator small{font-size:10px;letter-spacing:0}.caption{font-size:9px;letter-spacing:1.6px;color:#66738c;padding:0 11px 11px}.sidebar nav{display:grid;gap:5px}.sidebar nav button{display:flex;align-items:center;gap:12px;width:100%;border:1px solid transparent;background:transparent;color:#95a2b9;text-align:left;padding:12px;border-radius:9px;font-size:12px}.sidebar nav button:hover{background:#141e31;color:#e5edff}.sidebar nav button.active{background:linear-gradient(90deg,#1c3152,#14233c);border-color:#2d4770;color:#c6d9ff;box-shadow:inset 2px 0 #70a1ff}.sidebar nav em{font-style:normal;margin-left:auto;background:#723c35;color:#ffd0c9;border-radius:7px;padding:2px 7px;font-size:10px}.sidebottom{margin-top:auto}.sidehealth{padding:14px;border:1px solid #263149;background:#101a2b;border-radius:12px}.sidehealth i{display:inline-block;width:7px;height:7px;border-radius:50%;background:#41d6a0;margin-right:8px;box-shadow:0 0 10px #41d6a055}.sidehealth i.off{background:#f87171}.sidehealth b{font-size:10px;letter-spacing:.6px}.sidehealth strong{float:right;font-size:10px;color:#65deb0}.sidehealth small{display:block;color:#7786a0;font-size:10px;margin-top:10px}.operator{display:flex;align-items:center;gap:10px;padding:17px 4px 0}.operator>span{border-radius:50%;background:#3c335e;color:#e1d3ff}.operator>svg{margin-left:auto;color:#71809a}main{margin-left:246px;padding:0 34px;max-width:1800px}header{height:65px;border-bottom:1px solid #1b263a;display:flex;align-items:center;justify-content:space-between}.crumb,.headright{display:flex;align-items:center;gap:10px;font-size:11px;color:#77859c}.crumb b{color:#d9e3f5;font-weight:600}.headright{gap:16px}.environment{font-size:9px;letter-spacing:.8px;color:#8da4c8}.refresh,.button-secondary{border:1px solid #2a3850;background:#111b2d;color:#c6d2e6;border-radius:8px;padding:9px 12px;display:inline-flex;align-items:center;gap:8px;font-size:11px}.refresh:hover,.button-secondary:hover{border-color:#5477ae}.heading{display:flex;align-items:flex-end;justify-content:space-between;padding:30px 0 23px;gap:20px}.eyebrow{display:flex;align-items:center;gap:6px;font-size:9px;font-weight:700;letter-spacing:1.6px;color:#83a9ff}.heading h1{font:700 28px Manrope,sans-serif;letter-spacing:-.8px;margin:9px 0 7px;color:#f3f6fc}.heading p,.panelhead p{margin:0;color:#8390a8;font-size:12px}.heading .sync{font-size:9px;letter-spacing:1px;color:#72809a;text-align:right}.sync strong{display:block;color:#c5d0e2;font-size:12px;letter-spacing:0;margin-top:5px}.hero{display:flex;align-items:center;gap:16px;padding:21px 23px;border:1px solid #2c4a49;border-radius:14px;background:linear-gradient(105deg,#112a2b,#111b2a 68%);margin-bottom:17px}.hero.bad{border-color:#633c45;background:linear-gradient(105deg,#321c2a,#151a2b 68%)}.heroicon{width:48px;height:48px;display:grid;place-items:center;flex-shrink:0;border-radius:13px;background:#1c4b43;color:#6de1b4}.bad .heroicon{background:#512d38;color:#ff9b9b}.herotext{flex:1}.herotext>small{font-size:9px;color:#88c9b4;letter-spacing:1.2px}.bad .herotext>small{color:#ffaaa8}.hero h2{font:700 18px Manrope,sans-serif;margin:7px 0 5px;color:#f2f6fc}.hero p{margin:0;font-size:11px;color:#9eacc0;line-height:1.6}.pill{display:inline-flex;align-items:center;gap:6px;border-radius:30px;padding:6px 9px;font-size:10px;font-weight:600;white-space:nowrap;background:#1c293c;color:#b8c5da}.pill.green{background:#14372f;color:#7be0b8}.pill.red{background:#46262d;color:#ffaaaa}.pill.amber{background:#43351e;color:#f7cb78}.pill.blue{background:#1d3152;color:#a8c6ff}.cards{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:14px;margin-bottom:17px}.metric{position:relative;padding:17px 18px;border:1px solid #202d42;background:linear-gradient(145deg,#111b2d,#0d1524);border-radius:13px;min-height:140px;overflow:hidden}.metric:after{content:'';position:absolute;width:100px;height:100px;right:-45px;bottom:-50px;border-radius:50%;background:#263f6b20}.metricicon{display:grid;place-items:center;width:34px;height:34px;border-radius:10px;background:#1c3152;color:#8eb5ff;margin-bottom:15px}.metric:nth-child(2) .metricicon{background:#193a37;color:#68dfb1}.metric:nth-child(3) .metricicon{background:#412d3d;color:#f1a4c8}.metric:nth-child(4) .metricicon{background:#3e321f;color:#f7c978}.metric small{display:block;color:#8d9bb1;font-size:11px}.metric strong{display:block;font:700 25px Manrope,sans-serif;margin:5px 0;color:#f0f4fc;letter-spacing:-.5px}.metric>span{font-size:10px;color:#6e7d96}.twocol{display:grid;grid-template-columns:1.15fr 1fr;gap:16px;margin-bottom:17px}.panel{min-width:0;border:1px solid #202d42;background:linear-gradient(145deg,#101a2b,#0d1523);border-radius:13px;padding:20px;margin-bottom:17px}.twocol .panel{margin-bottom:0}.panelhead{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;margin-bottom:19px}.panelhead h3{font:700 13px Manrope,sans-serif;margin:0 0 6px;color:#e9effa}.panelhead p{font-size:10px}.pipeline{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:8px}.pipe{border:1px solid #28364d;border-radius:10px;padding:13px 10px;background:#111d30;min-width:0}.pipe small{display:grid;place-items:center;width:23px;height:23px;border-radius:7px;background:#233a5d;color:#a8c6ff;font-size:9px}.pipe b{display:block;font-size:10px;margin-top:12px;color:#dce6f6}.pipe span{display:block;color:#7f8da5;font-size:9px;line-height:1.5;margin-top:5px}.muted{color:#71809a;font-size:10px}.panel>.muted{margin-top:15px;line-height:1.5}.diagnosis{font:700 18px Manrope,sans-serif;line-height:1.4;margin:15px 0 8px}.panel>p{color:#94a2b8;font-size:11px;line-height:1.7}.linkbtn{display:inline-flex;align-items:center;gap:5px;border:0;background:transparent;color:#8fb4ff;font-size:11px;padding:12px 0 0}.recoverybox{display:flex;align-items:flex-start;gap:12px;padding:15px;border-radius:10px;border:1px solid #2a3c56;background:#121f33;color:#8eb4ff;margin-bottom:16px}.recoverybox b{color:#e2ebfa;font-size:12px}.recoverybox p{color:#8d9bb1;font-size:10px;line-height:1.6;margin:6px 0 0}.primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;border:1px solid #497be0;border-radius:8px;background:linear-gradient(110deg,#386fe0,#6557d9);color:white;font-size:11px;font-weight:600;padding:11px 14px}.primary:disabled{opacity:.5}.full{width:100%;margin-top:14px}.incident{display:flex;align-items:flex-start;gap:12px;padding:14px 0;border-bottom:1px solid #202b3e}.incident:last-child{border-bottom:0}.incident>svg{color:#f2b969;margin-top:3px;flex-shrink:0}.incident>div:nth-child(2){flex:1;min-width:0}.incident b{font-size:11px;color:#e4ebf7}.incident p{font-size:10px;line-height:1.5;color:#8897ae;margin:5px 0}.incident small,.history small{display:block;font-size:9px;color:#697b95}.incidentactions{display:flex;flex-direction:column;align-items:flex-end;gap:8px}.incidentactions button{background:#19283e;border:1px solid #314664;color:#c5d8f7;padding:5px 8px;border-radius:6px;font-size:9px}.empty{display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;gap:8px;padding:30px;color:#647c9c}.empty b{font-size:12px;color:#b7c5db}.empty span{font-size:10px}.healthrow{display:grid;grid-template-columns:1fr 1.2fr auto;align-items:center;gap:12px;padding:15px 0;border-bottom:1px solid #202b3e}.healthrow:last-child{border-bottom:0}.healthrow b{font-size:11px}.healthrow code{font-size:10px;color:#8ea9d2}.bigmetric{padding:16px 0;border-bottom:1px solid #263149}.bigmetric small{display:block;color:#8796ad;font-size:11px}.bigmetric b{display:block;font:700 26px Manrope,sans-serif;margin-top:8px}.raw{font-size:10px;color:#a3b7d6;margin-top:20px}.raw pre{white-space:pre-wrap;overflow-wrap:anywhere;background:#080e19;padding:12px;border-radius:8px;color:#82d7b4;font:10px ui-monospace,monospace;max-height:180px;overflow:auto}.probe{font:800 48px Manrope,sans-serif;margin:25px 0;color:#eaf0ff}.probe small{font-size:13px;color:#8192ae}.rcahero,.recoveryhero{margin-bottom:17px;border-color:#30426a;background:linear-gradient(110deg,#172747,#111b2c)}.evidence{display:flex;align-items:flex-start;gap:12px;padding:14px 0;border-bottom:1px solid #253148;font-size:11px;line-height:1.6;color:#c0cce0}.evidence span{font-size:10px;color:#7ea9ff;font-weight:700}.caveat{border:1px solid #4b4028;background:#292417;color:#d9bb7b;padding:12px;border-radius:8px;font-size:10px;line-height:1.6;margin-top:16px}.compare{display:flex;align-items:center;justify-content:space-between;padding:15px 0;border-bottom:1px solid #273148;font-size:11px;color:#91a0b8}.compare b{font-size:12px;color:#e7edf8}.recommend{background:#172640;border:1px solid #2b4366;padding:14px;border-radius:9px;margin-top:18px}.recommend b{font-size:11px;color:#a9c8ff}.recommend p{font-size:10px;line-height:1.6;color:#a0b0c8;margin-bottom:0}.step{padding:12px 0;border-bottom:1px solid #273148}.step b{font-size:11px;color:#cbdcff}.step p{font-size:10px;color:#8e9eb5;margin:5px 0 0;line-height:1.5}.safety{display:flex;gap:10px;background:#282316;border:1px solid #514328;color:#e9c57e;border-radius:9px;padding:13px;margin-top:15px}.safety b{font-size:11px}.safety p{font-size:10px;line-height:1.6;color:#c9b98e;margin:5px 0 0}.history{display:flex;gap:12px;align-items:flex-start;padding:14px 0;border-bottom:1px solid #263149}.history>svg{color:#87aaff}.history>div{flex:1}.history b{font-size:11px}.history p{font-size:10px;color:#93a1b7}.alert{display:flex;gap:12px;align-items:flex-start;border-radius:10px;padding:13px 15px;margin-bottom:15px;font-size:11px}.alert p{margin:5px 0 0;line-height:1.5}.alert.error{border:1px solid #793e47;background:#301a25;color:#ffb3b3}.alert.info{border:1px solid #315b54;background:#142a2b;color:#9be6c9}.alert button{margin-left:auto;background:transparent;border:0;color:inherit;font-size:10px}footer{display:flex;justify-content:space-between;gap:12px;padding:22px 0 28px;color:#63738d;font-size:9px}footer span:first-child{color:#81cdb0}@media(max-width:1150px){main{padding:0 22px}.sidebar{width:220px}main{margin-left:220px}.cards{grid-template-columns:repeat(2,1fr)}.twocol{grid-template-columns:1fr}.pipeline{grid-template-columns:repeat(4,1fr)}}@media(max-width:760px){.sidebar{position:relative;width:auto;height:auto;inset:auto;padding:14px}.sidebar nav{grid-template-columns:repeat(2,1fr)}.sidebottom,.workspace,.caption{display:none}.brand{padding-bottom:12px}main{margin-left:0;padding:0 14px}header{height:54px}.heading{align-items:flex-start;flex-direction:column;padding:22px 0 18px}.heading h1{font-size:23px}.heading .sync{display:none}.hero{align-items:flex-start;flex-wrap:wrap;padding:16px}.hero .pill{margin-left:64px}.cards{gap:9px}.metric{padding:13px;min-height:130px}.metric strong{font-size:21px}.panel{padding:15px}.pipeline{grid-template-columns:repeat(2,1fr)}.headright .environment{display:none}.healthrow{grid-template-columns:1fr auto}.healthrow code{grid-row:2}.twocol{gap:12px}footer{flex-direction:column}.incident{flex-wrap:wrap}.incidentactions{flex-direction:row}.brand b{font-size:16px}}